# 이 파일을 복사해 .env.local을 만들고 값을 채운다. .env.local은 커밋되지 않는다.
# Supabase 대시보드 → Project Settings → API Keys / Data API 에서 확인

# 프로젝트 주소 (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키 (sb_publishable_...). 브라우저에 노출돼도 되는 키다. secret 키는 절대 넣지 않는다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 관리자 키 (sb_secret_...). 서버(app/api/account, 계정 삭제)에서만 쓴다. RLS를 무시하므로 절대 NEXT_PUBLIC_을 붙이지 않는다.
# Supabase → Project Settings → API Keys → Secret keys. 없으면 계정 삭제만 "지금은 할 수 없어요"로 안내하고 나머지는 동작한다
SUPABASE_SECRET_KEY=

# Sentry 오류 보낼 주소 (DSN). 브라우저도 써야 해서 NEXT_PUBLIC_ (비밀 아님). 없으면 Sentry가 꺼진다 (로컬·CI는 비워 둔다)
# Sentry → Settings → Projects → (프로젝트) → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드 토큰(SENTRY_AUTH_TOKEN)은 비밀이라 Vercel 환경 변수에만 넣는다. 여기에는 적지 않는다

# AI 나키 (step3). Google AI Studio(https://aistudio.google.com/apikey)에서 만든 API 키. 서버(Route Handler)에서만 쓴다:
# NEXT_PUBLIC_을 붙이지 않는다 (브라우저 번들에 들어가면 누구나 키를 쓸 수 있다). 없으면 나키가 "지금은 쓸 수 없어요"로 안내한다
GOOGLE_GENERATIVE_AI_API_KEY=
# 쓸 모델 (선택, 기본 gemini-3.5-flash-lite). 무료 등급에서 쓸 수 있는 모델은 AI Studio에서 확인한다
NAKI_MODEL=
# 나키 하루 횟수 (선택, 기본 로그인 10 / 체험 3 / 서비스 전체 200). 세는 일에는 위의 SUPABASE_SECRET_KEY가 필요하다
NAKI_DAILY_LIMIT_USER=
NAKI_DAILY_LIMIT_GUEST=
NAKI_DAILY_LIMIT_GLOBAL=
# 테스트 전용: 1이면 AI를 부르지 않고 고정 응답 (CI E2E). Vercel Production에서는 켜지지 않는다. 여기에는 두지 않는다

# 루틴 푸시 알림 VAPID 공개 키 (base64url). 브라우저가 이 기기를 구독할 때 쓴다 (공개 키라 비밀 아님, NEXT_PUBLIC_).
# 짝인 비밀 키는 보내는 Edge Function의 Supabase secret에만 둔다 (35b). 비워 두면 알림 UI가 숨는다 (보내기가 없는 배포에서 켤 수 있는 척하지 않게)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
