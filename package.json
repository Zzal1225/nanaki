{
  "name": "nanaki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mts && lhci assert",
    "perf:calendar": "node scripts/calendar-perf.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.104",
    "@hookform/resolvers": "^5.9.2",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/turbopack": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.150",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "serwist": "^9.5.13",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
